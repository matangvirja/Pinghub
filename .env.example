# Copy to .env if you want to override docker-compose defaults.
# docker compose reads .env automatically for ${VARIABLE} substitution.

# --- Core message path -------------------------------------------------------

# Rate limiter (per client: 10 token burst, 1 token/second refill)
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SEC=1

# History cache lifetime
HISTORY_CACHE_TTL=60

# Mock notification provider
NOTIFY_MODE=random
NOTIFY_FAIL_RATE=0.3
NOTIFY_LATENCY_MS=50

# Worker resilience
NOTIFY_RETRY_ATTEMPTS=3
NOTIFY_RETRY_BASE_DELAY=1.0
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_SECONDS=30
WORKER_PREFETCH=5

# Gateway
HEALTH_CACHE_SECONDS=3
PROXY_TIMEOUT_SECONDS=5

# --- Ops API (dashboard + in-app Load Lab) ----------------------------------
# These are the in-network service addresses used by ops-api. The defaults in
# docker-compose.yml already match the Compose service names, so you only need
# to change them if you run ops-api outside Compose.
GATEWAY_URL=http://gateway:8000
NOTIFICATION_URL=http://notification-mock:8002
RABBITMQ_API_URL=http://rabbitmq:15672
RABBITMQ_USER=pinghub
RABBITMQ_PASSWORD=pinghub

# --- Published host ports (docker-compose.yml) ------------------------------
# The UI is the only port an end user needs:
#   http://localhost:3000   web app (nginx -> /api gateway, /ops ops-api)
#   http://localhost:8000   gateway API + /docs
#   http://localhost:8001   message-api
#   http://localhost:8002   notification mock
#   http://localhost:8003   ops-api + /docs
#   http://localhost:15672  RabbitMQ management (pinghub / pinghub)
#   http://localhost:8089   Locust UI (profile: loadtest)
# Change the host side in docker-compose.yml if a port is already in use.
