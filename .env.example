# Copy to .env if you want to override docker-compose defaults.
# docker compose reads .env automatically for ${VARIABLE} substitution.

# Rate limiter (per client: 10 token burst, 1 token/second refill)
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SEC=1

# History cache lifetime
HISTORY_CACHE_TTL=60

# Mock notification provider
NOTIFY_MODE=random
NOTIFY_FAIL_RATE=0.3
NOTIFY_LATENCY_MS=50

# Worker resilience
NOTIFY_RETRY_ATTEMPTS=3
NOTIFY_RETRY_BASE_DELAY=1.0
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_SECONDS=30
WORKER_PREFETCH=5

# Gateway
HEALTH_CACHE_SECONDS=3
PROXY_TIMEOUT_SECONDS=5
